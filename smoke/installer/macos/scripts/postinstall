#!/bin/bash
# Après installation : retire la quarantaine éventuelle et rafraîchit le cache Audio Unit
for p in "/Library/Audio/Plug-Ins/VST3/TortueGenial.vst3" \
         "/Library/Audio/Plug-Ins/Components/TortueGenial.component" \
         "/Applications/TortueGenial.app"; do
  [ -e "$p" ] && xattr -dr com.apple.quarantine "$p" 2>/dev/null
done
killall -9 AudioComponentRegistrar 2>/dev/null || true
exit 0
